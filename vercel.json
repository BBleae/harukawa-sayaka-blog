{
  "framework": "hugo",
  "installCommand": "curl -fsSL https://github.com/sass/dart-sass/releases/download/1.108.1/dart-sass-1.108.1-linux-x64.tar.gz | tar -xz -C /tmp",
  "buildCommand": "PATH=/tmp/dart-sass:$PATH hugo --gc --minify",
  "outputDirectory": "public",
  "build": {
    "env": {
      "HUGO_VERSION": "0.170.0"
    }
  }
}
